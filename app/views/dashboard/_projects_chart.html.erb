<%
  sdate     = Date.today - 1.month
  edate     = Date.today
  chartData = ProjectHoursChart.new(current_user, sdate, edate)
%>

<div class="columns">
  <h3>Hours by Project</h3>

  <div class="row show-for-medium">
    <div class="columns small-9">
      <canvas id="projects-chart" data-x-values="<%= chartData.values %>" data-y-values="<%= chartData.labels %>"></canvas>
    </div>

    <div class="columns small-3 float-right">
      <%= form_with do |f| %>

      <% end %>
    </div>
  </div>
</div>
